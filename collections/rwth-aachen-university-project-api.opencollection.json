{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coscine Web Admin Project API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Project",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves all projects.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://coscine.rwth-aachen.de/coscine/api/v2/projects",
            "params": [
              {
                "name": "IncludeOrganizations",
                "value": "",
                "type": "query",
                "description": "Gets or sets a value indicating whether to retrieve the organizations."
              },
              {
                "name": "TopLevel",
                "value": "",
                "type": "query",
                "description": "Gets or sets a value indicating whether to retrieve only top-level projects."
              },
              {
                "name": "PageNumber",
                "value": "",
                "type": "query",
                "description": "Gets or sets the desired page number. Should be greater than or equal to 1. Default is 1."
              },
              {
                "name": "PageSize",
                "value": "",
                "type": "query",
                "description": "Gets or sets the desired page size. Should be between 1 and the maximum allowed page size (50). Default is 10."
              },
              {
                "name": "OrderBy",
                "value": "",
                "type": "query",
                "description": "Gets or sets the field name used for ordering the results.\r\nThe order is constructed by an order string.\r\nUse the property followed by \"asc\" or \"desc\" and separate properties by commas. Default is asc.\r\nCan be used like this: \"propertyA asc, propertyB desc\"."
              }
            ]
          },
          "docs": "Retrieves all projects."
        },
        {
          "info": {
            "name": "Creates a new project.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://coscine.rwth-aachen.de/coscine/api/v2/projects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new project."
        },
        {
          "info": {
            "name": "Responds with the HTTP methods allowed for the endpoint.",
            "type": "http"
          },
          "http": {
            "method": "OPTIONS",
            "url": "https://coscine.rwth-aachen.de/coscine/api/v2/projects"
          },
          "docs": "Responds with the HTTP methods allowed for the endpoint."
        },
        {
          "info": {
            "name": "Retrieves a project.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://coscine.rwth-aachen.de/coscine/api/v2/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "The ID of the project."
              },
              {
                "name": "IncludeSubProjects",
                "value": "",
                "type": "query",
                "description": "Gets or sets a value indicating whether to include sub-projects in the retrieval."
              }
            ]
          },
          "docs": "Retrieves a project."
        },
        {
          "info": {
            "name": "Updates a project.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://coscine.rwth-aachen.de/coscine/api/v2/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "The ID of the project."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a project."
        },
        {
          "info": {
            "name": "Deletes a project.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://coscine.rwth-aachen.de/coscine/api/v2/projects/:projectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "The ID of the project."
              }
            ]
          },
          "docs": "Deletes a project."
        }
      ]
    }
  ],
  "bundled": true
}