{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coscine Web Admin Tos API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tos",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the current Terms of Service version.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://coscine.rwth-aachen.de/coscine/api/v2/tos"
          },
          "docs": "Retrieves the current Terms of Service version."
        },
        {
          "info": {
            "name": "Responds with the HTTP methods allowed for the endpoint.",
            "type": "http"
          },
          "http": {
            "method": "OPTIONS",
            "url": "https://coscine.rwth-aachen.de/coscine/api/v2/tos"
          },
          "docs": "Responds with the HTTP methods allowed for the endpoint."
        }
      ]
    }
  ],
  "bundled": true
}